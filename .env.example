# ==============================================================================
# TeamFlow Environment Variables Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# Server / Backend Configuration (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Development: mongodb://127.0.0.1:27017/teamflow
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/teamflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/teamflow

# Allowed Client Origin (CORS and Cookie validation)
CLIENT_URL=http://localhost:5173

# Cryptographic Token Keys (Use minimum 32 random characters in production)
JWT_ACCESS_SECRET=teamflow_jwt_access_secret_development_key_min32chars
JWT_REFRESH_SECRET=teamflow_jwt_refresh_secret_development_key_min32chars

# Cloudinary Cloud Storage (File Uploads & Avatar/Logo Assets)
# If left as placeholders, system gracefully falls back to local disk storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / SMTP Service (Email Notifications & Onboarding)
# Non-blocking async dispatch; operates safely if unconfigured
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ------------------------------------------------------------------------------
# Client / Frontend Configuration (client/.env)
# ------------------------------------------------------------------------------
# REST API Endpoint
VITE_API_URL=http://localhost:5000/api

# Real-Time WebSocket Server
VITE_SOCKET_URL=http://localhost:5000
